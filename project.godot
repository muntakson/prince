; Engine configuration file.
; Prince of mRNA
; Godot 4.3 — 2D story-driven educational game (desktop / web / Android)

config_version=5

[application]

config/name="Prince of mRNA"
config/description="A story-driven educational game teaching mRNA vaccine science."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.14, 0.09, 0.22, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

GameState="*res://autoload/GameState.gd"
Inventory="*res://autoload/Inventory.gd"
SaveManager="*res://autoload/SaveManager.gd"
DialogueManager="*res://autoload/DialogueManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
SceneManager="*res://autoload/SceneManager.gd"
DebugConsole="*res://autoload/DebugConsole.gd"
Classroom="*res://autoload/Classroom.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

